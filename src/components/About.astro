---
import Icon from "./Icon.astro";
import { p, t, ui, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = (ym: string) => ym.slice(0, 4);
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container-page">
    <h2 id="about-title" class="section-title">{t(ui.about.title, lang)}</h2>
    <div class="mx-auto max-w-2xl space-y-4 text-center text-lg text-fg-soft">
      {t(p.about, lang).map((para) => <p>{para}</p>)}
    </div>

    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
      <div class="reveal card p-6 backdrop-blur-sm">
        <h3 class="mb-4 flex items-center gap-2 text-lg font-semibold text-accent">
          <Icon name="graduation-cap" />
          {t(ui.about.education, lang)}
        </h3>
        <ul class="space-y-3">
          {
            p.education.map((e) => (
              <li>
                <p class="font-medium text-fg">{t(e.degree, lang)}</p>
                <p class="text-sm text-muted">
                  {t(e.school, lang)} · {e.start} – {e.end}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal card p-6 backdrop-blur-sm">
        <h3 class="mb-4 flex items-center gap-2 text-lg font-semibold text-accent">
          <Icon name="award" />
          {t(ui.about.certifications, lang)}
        </h3>
        <ul class="space-y-3">
          {
            p.certifications.map((c) => (
              <li>
                <p class="font-medium text-fg">{c.name}</p>
                <p class="text-sm text-muted">
                  {c.issuer} · {year(c.end)}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
