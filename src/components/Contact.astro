---
import Icon from "./Icon.astro";
import { p, t, ui, FORMSPREE_URL, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
  title?: string;
  intro?: string;
}

const c = ui.contact;
const { lang, title = t(c.title, lang), intro = t(c.intro, lang) } = Astro.props;

const field =
  "mt-2 block w-full rounded-lg border border-line bg-bg px-4 py-3 text-base text-fg placeholder:text-muted focus:border-accent focus:outline-2 focus:outline-offset-0 focus:outline-accent";
const direct = [
  { href: `mailto:${p.identity.email}`, icon: "mail", label: p.identity.email },
  { href: `tel:${p.identity.phoneE164}`, icon: "phone", label: p.identity.phone },
  { href: p.identity.linkedin, icon: "linkedin", label: "LinkedIn", external: true },
  { href: p.identity.github, icon: "github", label: "GitHub", external: true },
] as const;
---

<section id="contact" class="section border-t border-line" aria-labelledby="contact-title">
  <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
    <div>
      <h2 id="contact-title" class="section-title">{title}</h2>
      <p class="mt-4 max-w-md text-lg text-muted">{intro}</p>
      <p class="mt-8 font-semibold text-fg">{t(c.direct, lang)}</p>
      <ul class="mt-3 space-y-1">
        {
          direct.map((d) => (
            <li>
              <a
                href={d.href}
                target={"external" in d ? "_blank" : undefined}
                rel={"external" in d ? "noopener noreferrer" : undefined}
                class="inline-flex min-h-11 items-center gap-3 break-all text-fg hover:text-accent"
              >
                <Icon name={d.icon} class="text-accent" />
                {d.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <form
      action={FORMSPREE_URL}
      method="POST"
      data-contact-form
      class="reveal relative rounded-2xl border border-line bg-surface p-6 sm:p-8"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block font-medium text-fg">
          {t(c.name, lang)}
          <input type="text" name="name" autocomplete="name" required class={field} />
        </label>
        <label class="block font-medium text-fg">
          {t(c.email, lang)}
          <input type="email" name="email" autocomplete="email" required class={field} />
        </label>
      </div>
      <label class="mt-5 block font-medium text-fg">
        {t(c.message, lang)}
        <textarea name="message" rows="6" required class={field}></textarea>
      </label>

      <!-- Honeypot: hidden from people, filled by bots; Formspree drops those messages. -->
      <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
        <label>
          {t(c.honeypot, lang)}
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <button type="submit" class="btn-primary mt-6 w-full sm:w-auto" data-sending={t(c.sending, lang)}>
        <Icon name="send" size={18} />
        <span>{t(c.send, lang)}</span>
      </button>

      <p data-status="success" hidden class="mt-5 flex items-start gap-2 rounded-lg bg-accent-soft p-4 text-accent-soft-fg">
        <Icon name="check" class="mt-0.5" />
        {t(c.success, lang)}
      </p>
      <p data-status="error" hidden class="mt-5 flex items-start gap-2 rounded-lg border border-line bg-bg p-4 text-fg">
        <Icon name="alert" class="mt-0.5 text-accent" />
        {t(c.error, lang)}
      </p>
      <p class="sr-only" aria-live="polite" data-live></p>
    </form>
  </div>
</section>

<script>
  // Sends the form to Formspree without leaving the page and shows the result.
  // Without JavaScript the form still posts normally.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-contact-form]")) {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = button.querySelector("span")!;
    const idle = label.textContent;
    const show = (state: "success" | "error" | null) => {
      for (const el of form.querySelectorAll<HTMLElement>("[data-status]")) el.hidden = el.dataset.status !== state;
      const msg = state ? form.querySelector(`[data-status=${state}]`)?.textContent?.trim() : "";
      form.querySelector("[data-live]")!.textContent = msg ?? "";
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      show(null);
      button.disabled = true;
      label.textContent = button.dataset.sending ?? idle;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        show("success");
      } catch {
        show("error");
      } finally {
        button.disabled = false;
        label.textContent = idle;
      }
    });
  }
</script>
