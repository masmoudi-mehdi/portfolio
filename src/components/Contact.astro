---
import Icon from "./Icon.astro";
import { t, ui, FORMSPREE_URL, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
  title?: string;
  intro?: string;
}

const c = ui.contact;
const { lang, title = t(c.title, lang), intro = t(c.intro, lang) } = Astro.props;

// Underlined fields, like the old form. Labels stay for screen readers.
const field =
  "w-full border-b-2 border-cyan-500 bg-transparent py-4 text-xl text-fg placeholder:text-muted focus:border-cyan-300";
const errorClass = "mt-2 text-red-700 dark:text-red-400";
---

<section
  id="contact"
  class="section bg-linear-to-br from-bg to-blue-900/20"
  aria-labelledby="contact-title"
>
  <div class="container-page max-w-4xl">
    <h2 id="contact-title" class="section-title mb-4! sm:mb-6!">{title}</h2>
    <p class="mx-auto mb-12 max-w-2xl text-center text-lg text-muted">{intro}</p>

    <form action={FORMSPREE_URL} method="POST" data-contact-form data-required={t(c.required, lang)} data-invalid-email={t(c.invalidEmail, lang)} class="relative space-y-2">
      <div>
        <label for={`contact-name-${lang}`} class="sr-only">{t(c.name, lang)}</label>
        <input id={`contact-name-${lang}`} type="text" name="name" autocomplete="name" placeholder={t(c.name, lang)} required class={field} />
        <p id={`contact-name-${lang}-error`} data-error-for="name" hidden class={errorClass}></p>
      </div>
      <div>
        <label for={`contact-email-${lang}`} class="sr-only">{t(c.email, lang)}</label>
        <input id={`contact-email-${lang}`} type="email" name="email" autocomplete="email" placeholder={t(c.email, lang)} required class={field} />
        <p id={`contact-email-${lang}-error`} data-error-for="email" hidden class={errorClass}></p>
      </div>
      <div>
        <label for={`contact-message-${lang}`} class="sr-only">{t(c.message, lang)}</label>
        <textarea id={`contact-message-${lang}`} name="message" rows="4" placeholder={t(c.message, lang)} required class={field}></textarea>
        <p id={`contact-message-${lang}-error`} data-error-for="message" hidden class={errorClass}></p>
      </div>

      <!-- Honeypot: hidden from people, filled by bots; Formspree drops those messages. -->
      <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
        <label>
          {t(c.honeypot, lang)}
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <button
        type="submit"
        class="mt-4 flex w-full cursor-pointer items-center justify-center gap-3 rounded-xl bg-cta py-4 text-xl font-bold text-white transition-colors hover:bg-cta-hover disabled:opacity-70"
        data-sending={t(c.sending, lang)}
      >
        <Icon name="send" size={22} />
        <span>{t(c.send, lang)}</span>
      </button>

      <p data-status="success" hidden class="mt-5 flex items-start gap-2 rounded-lg border border-tag-line bg-tag p-4 text-tag-fg">
        <Icon name="check" class="mt-0.5" />
        {t(c.success, lang)}
      </p>
      <p data-status="error" hidden class="mt-5 flex items-start gap-2 rounded-lg border border-red-400/40 bg-red-500/10 p-4 text-fg">
        <Icon name="alert" class="mt-0.5 text-red-400" />
        {t(c.error, lang)}
      </p>
      <p class="sr-only" aria-live="polite" data-live></p>
    </form>
  </div>
</section>

<script>
  // Sends the form to Formspree without leaving the page and shows the result.
  // Without JavaScript the form still posts normally, with the browser's own checks.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-contact-form]")) {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = button.querySelector("span")!;
    const idle = label.textContent;
    const show = (state: "success" | "error" | null) => {
      for (const el of form.querySelectorAll<HTMLElement>("[data-status]")) el.hidden = el.dataset.status !== state;
      const msg = state ? form.querySelector(`[data-status=${state}]`)?.textContent?.trim() : "";
      form.querySelector("[data-live]")!.textContent = msg ?? "";
    };

    // Own checks instead of the browser bubbles: the messages are in the page
    // language, sit next to the field and are announced by screen readers.
    form.noValidate = true;
    type Field = HTMLInputElement | HTMLTextAreaElement;
    const fields = [...form.querySelectorAll<Field>("input[name=name], input[name=email], textarea")];
    const errorOf = (field: Field) => form.querySelector<HTMLElement>(`[data-error-for=${field.name}]`)!;
    const setError = (field: Field, message: string | null) => {
      const error = errorOf(field);
      error.hidden = !message;
      error.textContent = message;
      field.toggleAttribute("aria-invalid", !!message);
      if (message) field.setAttribute("aria-describedby", error.id);
      else field.removeAttribute("aria-describedby");
    };
    const problem = (field: Field) => {
      const value = field.value.trim();
      if (!value) return form.dataset.required!;
      if (field.type === "email" && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) return form.dataset.invalidEmail!;
      return null;
    };
    // Once a field shows an error, re-check it while typing so the message goes away.
    for (const field of fields) {
      field.addEventListener("input", () => field.hasAttribute("aria-invalid") && setError(field, problem(field)));
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      show(null);
      const invalid = fields.filter((field) => {
        const message = problem(field);
        setError(field, message);
        return message;
      });
      if (invalid.length) {
        invalid[0].focus();
        form.querySelector("[data-live]")!.textContent = errorOf(invalid[0]).textContent;
        return;
      }
      button.disabled = true;
      label.textContent = button.dataset.sending ?? idle;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        show("success");
      } catch {
        show("error");
      } finally {
        button.disabled = false;
        label.textContent = idle;
      }
    });
  }
</script>
