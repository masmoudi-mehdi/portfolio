---
import { p, t, ui, formatRange, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="experience" class="section border-t border-line" aria-labelledby="experience-title">
  <div class="container-page">
    <h2 id="experience-title" class="section-title">{t(ui.experience.title, lang)}</h2>

    <ol class="mt-10 sm:mt-14">
      {
        p.experience.map((job) => (
          <li class="reveal relative border-l border-line pb-12 pl-6 last:pb-2 md:grid md:grid-cols-[12rem_minmax(0,1fr)] md:border-0 md:pb-0 md:pl-0">
            <div class="text-sm md:pt-1 md:pr-8 md:text-right">
              <p class="font-semibold text-fg">{formatRange(job.start, job.end, lang)}</p>
              <p class="text-muted">{t(job.location, lang)}</p>
            </div>

            <div class="mt-3 md:relative md:mt-0 md:border-l md:border-line md:pb-14 md:pl-8 md:in-[li:last-child]:pb-2">
              <span
                class:list={[
                  "absolute top-1.5 -left-[6.5px] size-3 rounded-full ring-4 ring-bg md:top-2.5",
                  job.end ? "bg-line" : "bg-accent",
                ]}
                aria-hidden="true"
              />
              <h3 class="text-xl font-semibold text-fg">{t(job.role, lang)}</h3>
              <p class="mt-1">
                <span class="font-semibold text-accent">{job.company}</span>
                {job.client && (
                  <span class="text-muted">
                    {" · "}
                    {t(ui.experience.client, lang)}
                    {lang === "fr" ? " : " : ": "}
                    {t(job.client, lang)}
                  </span>
                )}
              </p>
              <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-muted">
                {t(job.bullets, lang).map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
