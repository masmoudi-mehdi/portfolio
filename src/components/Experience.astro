---
import { p, t, ui, formatRange, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const years = (start: string, end: string | null) =>
  `${start.slice(0, 4)} – ${end ? end.slice(0, 4) : t(ui.experience.present, lang)}`;
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container-page">
    <h2 id="experience-title" class="section-title">{t(ui.experience.title, lang)}</h2>

    <div class="relative">
      <!-- The cyan line: on the left on phones, in the middle from 768 px. -->
      <div class="absolute inset-y-0 left-5 w-0.5 bg-cyan-500 md:left-1/2 md:-translate-x-1/2" aria-hidden="true"></div>

      <ol class="space-y-12">
        {
          p.experience.map((job, i) => {
            const left = i % 2 === 0;
            return (
              <li class:list={["relative pl-12 md:w-1/2 md:pl-0", left ? "reveal-left md:pr-12" : "reveal-right md:ml-auto md:pl-12"]}>
                <span
                  class:list={[
                    "absolute top-0 left-0 z-10 -translate-y-1/2 rounded bg-cyan-700 px-2 py-1 text-xs font-semibold whitespace-nowrap text-white",
                    "md:top-6 md:text-sm",
                    left ? "md:left-[calc(100%+1.75rem)]" : "md:left-auto md:right-[calc(100%+1.75rem)]",
                  ]}
                >
                  {years(job.start, job.end)}
                </span>
                <span
                  class:list={[
                    "absolute top-6 hidden size-4 -translate-y-1/2 rounded-full border-4 border-bg bg-cyan-400 md:block",
                    left ? "-right-2" : "-left-2",
                  ]}
                  aria-hidden="true"
                />

                <article class="rounded-lg border border-line-soft bg-glass p-5 backdrop-blur-sm sm:p-6">
                  <h3 class="text-xl font-bold text-fg">{job.company}</h3>
                  <p class="font-medium text-accent">{t(job.role, lang)}</p>
                  <p class="mt-1 text-sm text-muted">
                    {formatRange(job.start, job.end, lang)} · {t(job.location, lang)}
                  </p>
                  {job.client && (
                    <p class="mt-2 text-sm text-fg-soft">
                      {t(ui.experience.client, lang)}
                      {lang === "fr" ? " : " : ": "}
                      {t(job.client, lang)}
                    </p>
                  )}
                  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-fg-soft marker:text-accent">
                    {t(job.bullets, lang).map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </article>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>
