---
// Vertical flow diagram drawn as inline SVG. Colours come from the site's CSS
// variables, so it follows the light/dark toggle. Text comes from profile.json.
interface Step {
  label: string;
  detail: string;
}
interface Props {
  steps: Step[];
  alt: string;
}

const { steps, alt } = Astro.props;
const W = 440;
const BOX_H = 72;
const GAP = 34;
const H = steps.length * BOX_H + (steps.length - 1) * GAP;
const rows = steps.map((step, i) => ({ ...step, i, y: i * (BOX_H + GAP) }));
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={alt} class="mx-auto h-auto w-full max-w-md" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="flow-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)"></path>
    </marker>
  </defs>
  {
    rows.map((row) => (
      <g>
        <rect x="1" y={row.y + 1} width={W - 2} height={BOX_H - 2} rx="12" fill="var(--card-solid)" stroke="var(--line)" stroke-width="2"></rect>
        <circle cx="40" cy={row.y + BOX_H / 2} r="19" fill="var(--cta)"></circle>
        <text x="40" y={row.y + BOX_H / 2 + 6} text-anchor="middle" font-size="18" font-weight="700" fill="#fff">
          {row.i + 1}
        </text>
        <text x="76" y={row.y + 31} font-size="18" font-weight="700" fill="var(--fg)">
          {row.label}
        </text>
        <text x="76" y={row.y + 54} font-size="15" fill="var(--fg-soft)">
          {row.detail}
        </text>
        {row.i < rows.length - 1 && (
          <line x1="40" y1={row.y + BOX_H + 3} x2="40" y2={row.y + BOX_H + GAP - 4} stroke="var(--accent)" stroke-width="2.5" marker-end="url(#flow-arrow)"></line>
        )}
      </g>
    ))
  }
</svg>
