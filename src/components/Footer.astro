---
import Icon from "./Icon.astro";
import { p, t, ui, type Lang, type PageKey } from "../lib/profile";

interface Props {
  lang: Lang;
  page?: PageKey;
}

const { lang } = Astro.props;
const f = ui.footer;
const year = new Date().getFullYear();
---

<footer class="relative z-10 bg-bg-alt py-12">
  <div class="container-page">
    <div class="grid grid-cols-1 gap-10 text-center md:grid-cols-3 md:text-left">
      <div>
        <h2 class="mb-4 text-2xl font-bold text-accent">{t(f.contactTitle, lang)}</h2>
        <ul class="space-y-3">
          <li>
            <a
              href={`tel:${p.identity.phoneE164}`}
              class="inline-flex items-center gap-3 text-fg-soft transition-colors hover:text-accent"
            >
              <Icon name="phone" size={18} />
              {p.identity.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${p.identity.email}`}
              class="inline-flex items-center gap-3 break-all text-fg-soft transition-colors hover:text-accent"
            >
              <Icon name="mail" size={18} />
              {p.identity.email}
            </a>
          </li>
        </ul>
      </div>

      <div class="md:text-center">
        <h2 class="mb-4 text-2xl font-bold text-accent">{t(f.socialTitle, lang)}</h2>
        <ul class="flex justify-center gap-2">
          <li>
            <a
              href={p.identity.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="inline-flex size-11 items-center justify-center text-fg-soft transition-colors hover:text-accent"
            >
              <Icon name="linkedin" size={24} />
            </a>
          </li>
          <li>
            <a
              href={p.identity.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="inline-flex size-11 items-center justify-center text-fg-soft transition-colors hover:text-accent"
            >
              <Icon name="github" size={24} />
            </a>
          </li>
        </ul>
      </div>

      <div class="md:text-right">
        <h2 class="mb-4 text-2xl font-bold text-accent">{t(f.copyrightTitle, lang)}</h2>
        <p class="text-fg-soft">© {year} {p.identity.name}.</p>
        <p class="text-fg-soft">{t(f.rights, lang)}</p>
      </div>
    </div>

    <p class="mt-10 flex items-center justify-center gap-2 border-t border-line pt-8 text-center text-fg-soft">
      <Icon name="gamepad" />
      {t(ui.konami.hint, lang)}
    </p>
  </div>
</footer>
