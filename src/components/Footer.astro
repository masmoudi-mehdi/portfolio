---
import Icon from "./Icon.astro";
import { p, t, ui, type Lang, type PageKey } from "../lib/profile";

interface Props {
  lang: Lang;
  page?: PageKey;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div class="container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-semibold text-fg">{p.identity.name}</p>
      <p class="text-sm text-muted">{t(p.identity.title, lang)} · {t(p.identity.location, lang)}</p>
    </div>
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <li>
        <a href={`mailto:${p.identity.email}`} class="inline-flex items-center gap-2 text-muted hover:text-accent">
          <Icon name="mail" size={18} />
          {p.identity.email}
        </a>
      </li>
      <li>
        <a href={`tel:${p.identity.phoneE164}`} class="inline-flex items-center gap-2 text-muted hover:text-accent">
          <Icon name="phone" size={18} />
          {p.identity.phone}
        </a>
      </li>
      <li>
        <a
          href={p.identity.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="inline-flex size-11 items-center justify-center text-muted hover:text-accent"
        >
          <Icon name="linkedin" />
        </a>
      </li>
      <li>
        <a
          href={p.identity.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="inline-flex size-11 items-center justify-center text-muted hover:text-accent"
        >
          <Icon name="github" />
        </a>
      </li>
    </ul>
  </div>
  <div class="container-page border-t border-line py-5 text-sm text-muted">
    © {year} {p.identity.name}. {t(ui.footer.rights, lang)}
  </div>
</footer>
