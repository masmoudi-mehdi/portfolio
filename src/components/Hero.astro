---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import photo from "../assets/mehdi.webp";
import { p, t, ui, CV_URL, CV_DOWNLOAD_NAME, otherLang, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other = otherLang(lang);
---

<section class="container-page pt-10 pb-16 sm:pt-16 sm:pb-20 lg:pt-24 lg:pb-28">
  <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
    <div class="lg:order-last">
      <Picture
        src={photo}
        alt={t(ui.hero.photoAlt, lang)}
        widths={[224, 320, 640]}
        sizes="(min-width: 1024px) 320px, (min-width: 640px) 160px, 112px"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        width={640}
        height={630}
        loading="eager"
        fetchpriority="high"
        class="size-28 rounded-full object-cover shadow-sm ring-1 ring-line sm:size-40 lg:size-80 lg:rounded-3xl"
      />
    </div>

    <div>
      <h1>
        <span class="block text-lg font-semibold text-accent">{p.identity.name}</span>
        <span class="mt-3 block text-3xl font-bold tracking-tight text-fg">{t(p.headline, lang)}</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">{t(p.subline, lang)}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a href="#contact" class="btn-primary">
          <Icon name="mail" size={18} />
          {t(ui.hero.contact, lang)}
        </a>
        <a href={CV_URL[lang]} download={CV_DOWNLOAD_NAME[lang]} class="btn-secondary">
          <Icon name="download" size={18} />
          {t(ui.hero.cv, lang)}
        </a>
        <a
          href={CV_URL[other]}
          download={CV_DOWNLOAD_NAME[other]}
          hreflang={other}
          lang={other}
          class="link self-start text-sm sm:self-center sm:ml-2"
        >
          {t(ui.hero.cvOther, lang)}
        </a>
      </div>

      <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-muted">
        <li class="inline-flex items-center gap-2">
          <Icon name="map-pin" size={18} />
          {t(p.identity.location, lang)}
        </li>
        <li>
          <a
            href={p.identity.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 hover:text-accent"
          >
            <Icon name="linkedin" size={18} />
            LinkedIn
          </a>
        </li>
        <li>
          <a
            href={p.identity.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 hover:text-accent"
          >
            <Icon name="github" size={18} />
            GitHub
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
