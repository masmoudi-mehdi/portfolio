---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import photo from "../assets/mehdi.webp";
import { p, t, ui, CV_URL, CV_DOWNLOAD_NAME, LANGS, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cvLabel = { fr: ui.hero.cvFr, en: ui.hero.cvEn };
---

<section id="hero" class="relative flex min-h-[calc(100svh-4rem)] items-center justify-center py-16">
  <div class="pointer-events-none absolute inset-0 bg-linear-to-b from-cyan-500/10 to-transparent opacity-50" aria-hidden="true">
  </div>

  <div class="container-page relative text-center">
    <div class="mx-auto size-36 overflow-hidden rounded-full border-4 border-cyan-400 shadow-[0_0_40px_rgb(34_211_238/0.25)] sm:size-48">
      <Picture
        src={photo}
        alt={t(ui.hero.photoAlt, lang)}
        widths={[192, 384]}
        sizes="(min-width: 640px) 192px, 144px"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        width={384}
        height={378}
        loading="eager"
        fetchpriority="high"
        class="size-full object-cover"
      />
    </div>

    <h1 class="gradient-text mx-auto mt-8 max-w-5xl pb-2 text-4xl leading-tight font-bold sm:text-5xl md:text-7xl">
      <span class="sr-only">{p.identity.name} – </span>{t(p.headline, lang)}
    </h1>
    <p class="mx-auto mt-6 max-w-3xl text-xl text-muted md:text-2xl">{t(p.subline, lang)}</p>

    <div class="mt-10 flex flex-col items-stretch justify-center gap-4 sm:flex-row sm:items-center sm:gap-6">
      <a href="#contact" class="btn-cta">
        <Icon name="send" size={20} />
        {t(ui.hero.contact, lang)}
      </a>
      <button type="button" popovertarget="cv-dialog" class="btn-cta cursor-pointer">
        <Icon name="file-down" size={20} />
        {t(ui.hero.cv, lang)}
      </button>
    </div>
  </div>
</section>

<!-- CV picker, like the old modal. Popover API: works without JavaScript. -->
<div
  id="cv-dialog"
  popover
  role="dialog"
  aria-labelledby="cv-dialog-title"
  class="m-auto w-[min(28rem,calc(100%-2rem))] rounded-xl border border-line bg-card-solid p-8 text-fg shadow-2xl backdrop:bg-black/70"
>
  <h2 id="cv-dialog-title" class="mb-6 text-2xl font-bold">{t(ui.hero.cvChoose, lang)}</h2>
  <div class="space-y-4">
    {
      LANGS.map((l) => (
        <a
          href={CV_URL[l]}
          download={CV_DOWNLOAD_NAME[l]}
          data-cv={l}
          hreflang={l}
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-gray-300 py-3 font-medium text-gray-900 hover:bg-gray-400"
        >
          <Icon name="file-down" size={20} />
          {t(cvLabel[l], lang)}
        </a>
      ))
    }
  </div>
  <button
    type="button"
    popovertarget="cv-dialog"
    popovertargetaction="hide"
    class="mt-6 flex w-full cursor-pointer items-center justify-center gap-2 py-2 text-muted hover:text-fg"
  >
    <Icon name="x" size={18} />
    {t(ui.hero.close, lang)}
  </button>
</div>

<script>
  // Counts CV downloads as GoatCounter events (no-op when the counter is off or blocked).
  for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-cv]")) {
    link.addEventListener("click", () => {
      const count = (window as any).goatcounter?.count;
      count?.({ path: `cv-${link.dataset.cv}`, title: `CV ${link.dataset.cv}`, event: true });
    });
  }
</script>
