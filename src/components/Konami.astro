---
import { t, ui, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const k = ui.konami;
---

<dialog
  id="konami"
  aria-labelledby="konami-title"
  class="m-auto w-[min(32rem,calc(100%-2rem))] bg-transparent p-4 text-center text-white backdrop:bg-black/95"
>
  <p id="konami-title" class="mb-4 text-3xl font-bold text-cyan-400 sm:text-4xl">🎮 {t(k.title, lang)} 🎮</p>
  <div class="rounded-2xl border-2 border-cyan-400 bg-cyan-500/10 p-8">
    <p class="mb-4 text-lg">{t(k.text, lang)}</p>
    <p class="text-3xl font-bold tracking-[0.3em] text-cyan-400">{k.code}</p>
    <p class="mt-4 text-gray-400">{t(k.offer, lang)}</p>
  </div>
  <form method="dialog" class="mt-8">
    <button class="btn-cta cursor-pointer">{t(k.close, lang)}</button>
  </form>
</dialog>

<script>
  // Easter egg: ↑ ↑ ↓ ↓ ← → ← → B A opens the promo-code dialog.
  const SEQUENCE = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a"];
  let step = 0;
  document.addEventListener("keydown", (e) => {
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    step = key === SEQUENCE[step] ? step + 1 : key === SEQUENCE[0] ? 1 : 0;
    if (step === SEQUENCE.length) {
      step = 0;
      (document.getElementById("konami") as HTMLDialogElement | null)?.showModal();
    }
  });
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    dialog[open] {
      animation: pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.9;
    }
  }
</style>
