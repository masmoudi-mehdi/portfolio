---
import Icon from "./Icon.astro";
import { p, t, ui, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const labels = ui.projects;
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container-page">
    <h2 id="projects-title" class="section-title">{t(labels.title, lang)}</h2>

    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        p.projects.map((project) => {
          const details = [
            [labels.problem, project.problem],
            [labels.built, project.built],
            [labels.role, project.role],
            [labels.result, project.result],
          ] as const;
          return (
            <li class="reveal card flex flex-col p-6 backdrop-blur-sm">
              <h3 class="mb-1 text-xl font-bold text-fg">{t(project.name, lang)}</h3>
              <p class="mb-4 text-sm text-accent">{t(project.oneLiner, lang)}</p>
              {"context" in project && project.context && (
                <p class="mb-3 text-sm font-semibold text-fg">{t(project.context, lang)}</p>
              )}
              <dl class="mb-5 space-y-3 text-sm text-fg-soft">
                {details.map(([label, text]) => (
                  <div>
                    <dt class="font-semibold text-fg">{t(label, lang)}</dt>
                    <dd>{t(text, lang)}</dd>
                  </div>
                ))}
              </dl>
              <ul class="mt-auto flex flex-wrap gap-2" aria-label={t(labels.stack, lang)}>
                {project.stack.map((tech) => (
                  <li class="chip">{tech}</li>
                ))}
              </ul>
              {project.link && (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="link mt-4 inline-flex items-center gap-1.5">
                  {t(project.name, lang)}
                  <Icon name="arrow-up-right" size={16} />
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
