---
import { p, t, ui, type Lang } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container-page">
    <h2 id="skills-title" class="section-title">{t(ui.skills.title, lang)}</h2>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        p.skills.map((group) => (
          <div class="skill-card reveal card p-6 backdrop-blur-sm">
            <h3 class="mb-4 text-lg font-semibold text-accent">{t(group.group, lang)}</h3>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="tag">{t(item, lang)}</li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="skill-card reveal card p-6 backdrop-blur-sm">
        <h3 class="mb-4 text-lg font-semibold text-accent">{t(ui.skills.languages, lang)}</h3>
        <ul class="space-y-2">
          {
            p.languages.map((l) => (
              <li class="flex justify-between gap-4">
                <span class="font-medium text-fg">{t(l.name, lang)}</span>
                <span class="text-fg-soft">{t(l.level, lang)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Lift and cyan glow on hover, like the old skill cards. */
  @media (prefers-reduced-motion: no-preference) {
    .skill-card {
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    }
    .skill-card:hover {
      transform: translateY(-5px);
      box-shadow:
        0 15px 35px rgb(0 0 0 / 0.2),
        0 0 30px rgb(6 182 212 / 0.15);
    }
  }
</style>
